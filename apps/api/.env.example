# Supabase direct connection (Project Settings -> Database -> Connection string -> Direct). Do NOT use the 6543 pooler.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-2
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

APP_ENV=development
PORT=4000

# WhatsApp Cloud API (leave blank in dev to skip signature verification)
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=wa-verify-token