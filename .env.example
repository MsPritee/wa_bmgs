# ------------------------------------------------------------------
# API server (apps/api/.env):
# ------------------------------------------------------------------
# Supabase direct connection string (NOT the 6543 transaction-pooler).
# Project Settings -> Database -> Connection string -> Direct
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

APP_ENV=development
PORT=4000

# WhatsApp Cloud API (leave blank in dev to skip signature verification)
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=wa-verify-token

# ------------------------------------------------------------------
# Web dashboard (apps/web/.env):
# ------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api/v1

# CORS allowlist for API (comma-separated origins)
WEB_ORIGIN=http://localhost:5173